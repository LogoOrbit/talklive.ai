{
  "name": "talklive",
  "version": "1.0.0",
  "description": "TalkLive - free random voice chat to talk to strangers worldwide",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "build:usernames": "node scripts/build-username-words.js",
    "build:seo": "node scripts/build-seo.js && node scripts/migrate-retired-links.js && node scripts/migrate-schema.js && node scripts/migrate-languages.js && node scripts/migrate-pwa.js && node scripts/migrate-ads.js && node scripts/migrate-analytics.js && node scripts/migrate-internal-utm.js && node scripts/migrate-social.js",
    "ads:migrate": "node scripts/migrate-ads.js",
    "audit:seo": "node scripts/audit-seo.js",
    "check:bundle": "node scripts/check-bundle-size.js",
    "build:min": "node scripts/minify-assets.js",
    "check:seo": "npm run build:seo && npm run audit:seo",
    "check:turn": "node scripts/check-turn.js",
    "test:billing": "node scripts/test-billing.js",
    "test:referral": "node scripts/test-referral.js",
    "test:reset": "node scripts/test-password-reset.js",
    "test:chat": "node scripts/test-chat-extras.js && node scripts/test-chat-away.js",
    "test:matchmaking": "node scripts/test-matchmaking.js",
    "test:malformed": "node scripts/test-malformed-packets.js",
    "test:voice-gender": "node scripts/test-voice-gender.js && node scripts/test-voice-filter.js",
    "test:durability": "node scripts/test-durability.js",
    "test:fast-save": "node scripts/test-fast-save.js",
    "test:analytics": "node scripts/test-analytics-visits.js",
    "test:warnings": "node scripts/test-owner-warning.js",
    "test:contacts": "node scripts/test-contact-capture.js",
    "test:feedback-reply": "node scripts/test-feedback-reply.js",
    "test:audience": "node scripts/test-audience.js",
    "test:gifs": "node scripts/test-gif-proxy.js",
    "test:films": "node scripts/test-fav-films.js",
    "seo:ping": "node scripts/ping-indexnow.js",
    "test:social": "node scripts/test-social.js && node scripts/test-social-safety.js && node scripts/test-social-delivery.js && node scripts/test-social-extras.js && node scripts/test-social-privacy.js",
    "test:friend-id": "node scripts/test-friend-id.js",
    "test:discovery": "node scripts/test-discovery.js",
    "test:social-ui": "node scripts/social-ui/stress-call.js && node scripts/social-ui/stress-chat.js && node scripts/social-ui/stress-delivery.js && node scripts/social-ui/voice-notes-ui.js",
    "test:social-load": "node scripts/social-ui/load.js",
    "test:voice-notes": "node scripts/test-voice-notes.js",
    "test:games": "node scripts/test-games-stats.js",
    "test:traffic": "node scripts/test-traffic.js",
    "test:twins": "node scripts/test-twin-match.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "express": "^4.19.2",
    "geoip-lite": "^1.4.10",
    "google-auth-library": "^9.15.1",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.7.5",
    "web-push": "^3.6.7"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "csso": "^5.0.5",
    "socket.io-client": "^4.8.3",
    "terser": "^5.51.2"
  }
}
