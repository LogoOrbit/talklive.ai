{
  "name": "talklive",
  "version": "1.0.0",
  "description": "TalkLive - free random voice chat to talk to strangers worldwide",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "build:seo": "node scripts/build-seo.js && node scripts/migrate-adsterra.js",
    "ads:adsterra": "node scripts/migrate-adsterra.js",
