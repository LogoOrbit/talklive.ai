{
  "name": "talklive",
  "version": "1.0.0",
  "description": "TalkLive - free random voice chat to talk to strangers worldwide",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "build:usernames": "node scripts/build-username-words.js",
    "build:seo": "node scripts/build-seo.js && node scripts/migrate-schema.js && node scripts/migrate-hub-schema.js && node scripts/migrate-pwa.js && node scripts/migrate-adsterra.js && node scripts/migrate-analytics.js && node scripts/migrate-internal-utm.js",
    "ads:adsterra": "node scripts/migrate-adsterra.js",
    "audit:seo": "node scripts/audit-seo.js",
    "check:seo": "npm run build:seo && npm run audit:seo",
    "check:turn": "node scripts/check-turn.js",
    "test:billing": "node scripts/test-billing.js",
    "test:referral": "node scripts/test-referral.js",
    "test:reset": "node scripts/test-password-reset.js",
    "test:chat": "node scripts/test-chat-extras.js",
    "test:matchmaking": "node scripts/test-matchmaking.js",
    "test:durability": "node scripts/test-durability.js",
    "test:analytics": "node scripts/test-analytics-visits.js",
    "test:gifs": "node scripts/test-gif-proxy.js",
    "seo:ping": "node scripts/ping-indexnow.js",
    "test:social": "node scripts/test-social.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "geoip-lite": "^1.4.10",
    "google-auth-library": "^9.15.1",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.7.5",
    "web-push": "^3.6.7"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3"
  }
}
