{
  "appId": "app.talklive",
  "appName": "TalkLive",
  "webDir": "www",
  "server": {
    "url": "https://talklive.app/?utm_source=mobile_app",
    "hostname": "talklive.app",
    "androidScheme": "https",
    "errorPath": "offline.html"
  },
  "appendUserAgent": "TalkLiveApp/1",
  "backgroundColor": "#0b0f1a",
  "android": {
    "allowMixedContent": false,
    "captureInput": true
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
